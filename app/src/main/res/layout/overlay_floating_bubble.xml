<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutFloatingBubble"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_bubble"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp" android:paddingRight="14dp"
    android:paddingTop="8dp" android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvBubbleTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏱ 05:00"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBubbleAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLength="12"
        android:text="App"
        android:textColor="#E0F2FE"
        android:textSize="11sp" />
</LinearLayout>