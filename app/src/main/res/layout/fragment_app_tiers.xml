<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_app" android:orientation="vertical" android:padding="14dp">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="অ্যাপের নিয়ম ঠিক করো" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"><TextView android:id="@+id/tvCountAll" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:text="সব" android:textColor="@color/text_primary"/><TextView android:id="@+id/tvCountWhitelist" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:text="খোলা" android:textColor="@color/tier_whitelist"/><TextView android:id="@+id/tvCountGreylist" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:text="টাইমার" android:textColor="@color/tier_greylist"/><TextView android:id="@+id/tvCountBlacklist" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:text="ব্লক" android:textColor="@color/tier_blacklist"/></LinearLayout>
 <EditText android:id="@+id/etSearchApps" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_pill_toggle" android:hint="অ্যাপ খোঁজো" android:paddingLeft="12dp" android:paddingRight="12dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp"><EditText android:id="@+id/etGreylistWarning" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:hint="টাইম শেষের মেসেজ" android:singleLine="true" android:textColor="@color/text_primary"/><EditText android:id="@+id/etBlacklistWarning" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:hint="ব্লক মেসেজ" android:singleLine="true" android:textColor="@color/text_primary"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/btnSaveWarnings" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="মেসেজ সেভ" app:cornerRadius="14dp"/><com.google.android.material.button.MaterialButton android:id="@+id/btnAddNewApp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="অ্যাপ যোগ করুন" app:cornerRadius="14dp"/></LinearLayout>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAppTiers" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="80dp" android:nestedScrollingEnabled="true"/>
</LinearLayout>
