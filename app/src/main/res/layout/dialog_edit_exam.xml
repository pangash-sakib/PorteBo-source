<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="পরীক্ষা যোগ করো"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etExamSubject"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_toggle"
        android:hint="বিষয়ের নাম (যেমন: Physics 1st Paper)"
        android:paddingLeft="14dp" android:paddingRight="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etExamDate"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_toggle"
        android:hint="তারিখ (YYYY-MM-DD)"
        android:paddingLeft="14dp" android:paddingRight="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveExam"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="সেভ করো"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="14dp" />
</LinearLayout>