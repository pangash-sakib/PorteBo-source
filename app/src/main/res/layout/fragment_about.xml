  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="22dp" app:cardElevation="1dp" app:strokeColor="@color/border_subtle" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="১. Whitelist · সবসময় খোলা" android:textColor="@color/tier_whitelist" android:textSize="16sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="ক্যালকুলেটর, PDF reader, Docs-এর মতো পড়ার অ্যাপ খোলা থাকবে। ফোন, Settings, Messages ও দরকারি system app-ও সবসময় খোলা।" android:textColor="@color/text_secondary" android:textSize="13sp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="২. Greylist · অ্যাপ-পিছু ৫ মিনিট" android:textColor="@color/tier_greylist" android:textSize="16sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="প্রতিটি অ্যাপের আলাদা ৫ মিনিটের কোটা। অ্যাপ ছাড়লে টাইমার থামে, আবার ঢুকলে চলে। স্ক্রিনে ভাসমান টাইমার দেখাবে।" android:textColor="@color/text_secondary" android:textSize="13sp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="৩. Blacklist · লকডাউনে ব্লক" android:textColor="@color/tier_blacklist" android:textSize="16sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="লকডাউনে এই অ্যাপ খুললে আগে ব্লক স্ক্রিন দেখাবে, তারপর হোমে ফিরবে।" android:textColor="@color/text_secondary" android:textSize="13sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
